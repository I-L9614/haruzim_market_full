PORT=3000
# Replace with a production MongoDB Atlas URI (use a replica set for checkout transactions).
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/haruzim_db?retryWrites=true&w=majority
# Comma-separated exact origins only; replace with the deployed HTTPS storefront/admin web origins.
CLIENT_ORIGIN=http://localhost:3001,http://localhost:3002
# Packaged Electron uses an app-specific secure origin. Keep this exact value aligned with electron/main.js.
ELECTRON_ORIGIN=haruzim://admin
JWT_SECRET=
# Set once to create the initial admin; may be omitted after the admin account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store Admin
# Google Identity Services OAuth Web client ID; must match customer-web VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Optional Telegram order notifications. Leave both empty to disable external notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cal payment integration is intentionally inactive until explicitly implemented and enabled.
PAYMENT_MODE=offline
DELIVERY_MANAGER_PHONE=972545901127
